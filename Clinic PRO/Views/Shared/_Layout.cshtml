@{
    var isLoggedIn = Context.Session.GetInt32("AccountId") != null;
    var role = Context.Session.GetString("Role");
    var roleAr = role == "Doctor" ? "دكتور" : "مريض";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clinic PRO</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Clinic_PRO.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg clinic-nav">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></span>
                    <span>Clinic PRO</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            @if (isLoggedIn)
                            {
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i>لوحة التحكم</a>
                            }
                            else
                            {
                                <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i>الرئيسية</a>
                            }
                        </li>

                        @if (isLoggedIn && role == "Patient")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointment" asp-action="ChooseDoctor"><i class="bi bi-calendar-plus"></i>احجز موعد</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointment" asp-action="MyAppointments"><i class="bi bi-calendar2-check"></i>مواعيدي</a>
                            </li>
                        }

                        @if (isLoggedIn && role == "Doctor")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointment" asp-action="DoctorAppointments"><i class="bi bi-journal-medical"></i>مواعيد اليوم</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointment" asp-action="MySlots"><i class="bi bi-clock-history"></i>إدارة الأوقات</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-lg-1">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item me-lg-2">
                                <span class="user-chip"><i class="bi bi-person-circle"></i>مرحبا، @roleAr</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Notification" asp-action="Index"><i class="bi bi-bell"></i>الإشعارات</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-left"></i>تسجيل خروج</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i>تسجيل دخول</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">إنشاء حساب</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container page-wrap">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>&copy; 2026 Clinic PRO - جميع الحقوق محفوظة</span>
            <a asp-controller="Home" asp-action="Privacy">سياسة الخصوصية</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>