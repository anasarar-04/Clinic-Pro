@model List<ClinicPRO.Application.DTOs.AvailableSlotDto>

@{
    ViewData["Title"] = "اختر الموعد";
    var doctorId = ViewBag.DoctorId;
}

<h3 class="mb-4">اختر الوقت المناسب</h3>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">لا يوجد أوقات متاحة حاليا لهذا الدكتور.</p>
}
else
{
    <div class="list-group">
        @foreach (var slot in Model)
        {
            <form asp-action="Book" method="post" class="list-group-item d-flex justify-content-between align-items-center">
                <span>
                    @slot.SlotDate.ToString("yyyy-MM-dd") &nbsp;|&nbsp;
                    @slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")
                </span>
                <input type="hidden" name="doctorId" value="@doctorId" />
                <input type="hidden" name="slotId" value="@slot.SlotId" />
                <button type="submit" class="btn btn-success btn-sm">احجز</button>
            </form>
        }
    </div>
}

<a asp-action="ChooseDoctor" class="btn btn-link mt-3">&larr; رجوع لاختيار دكتور آخر</a>