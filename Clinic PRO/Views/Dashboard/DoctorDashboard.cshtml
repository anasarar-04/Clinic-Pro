@model DoctorDashboardViewModel

@{
    ViewData["Title"] = "لوحة التحكم";
}

@functions {
    string StatusText(ClinicPRO.Domain.Enums.AppointmentStatus s) => s switch
    {
        ClinicPRO.Domain.Enums.AppointmentStatus.Confirmed => "مؤكد",
        ClinicPRO.Domain.Enums.AppointmentStatus.Completed => "مكتمل",
        ClinicPRO.Domain.Enums.AppointmentStatus.Cancelled => "ملغى",
        _ => "قيد الانتظار"
    };

    string StatusClass(ClinicPRO.Domain.Enums.AppointmentStatus s) => s switch
    {
        ClinicPRO.Domain.Enums.AppointmentStatus.Confirmed => "badge bg-success",
        ClinicPRO.Domain.Enums.AppointmentStatus.Completed => "badge bg-secondary",
        ClinicPRO.Domain.Enums.AppointmentStatus.Cancelled => "badge bg-danger",
        _ => "badge bg-warning text-dark"
    };
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<section class="dash-welcome mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2>أهلا دكتور @Model.FullName</h2>
            <p>ملخص يومك ومواعيد مرضاك بمكان واحد.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-hero" asp-controller="Appointment" asp-action="DoctorAppointments"><i class="bi bi-journal-medical"></i> كل المواعيد</a>
            <a class="btn btn-hero-outline" asp-controller="Appointment" asp-action="MySlots">إدارة الأوقات</a>
        </div>
    </div>
</section>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="stat-icon"><i class="bi bi-calendar-day"></i></div>
            <div>
                <div class="stat-value">@Model.TodayCount</div>
                <div class="stat-label">مواعيد اليوم</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="stat-icon amber"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="stat-value">@Model.PendingCount</div>
                <div class="stat-label">بانتظار الكشف</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="stat-icon violet"><i class="bi bi-clock"></i></div>
            <div>
                <div class="stat-value">@Model.FreeSlotsCount</div>
                <div class="stat-label">أوقات متاحة</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="stat-icon green"><i class="bi bi-check2-circle"></i></div>
            <div>
                <div class="stat-value">@Model.CompletedCount</div>
                <div class="stat-label">زيارات مكتملة</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="mb-3"><i class="bi bi-calendar-day"></i> مواعيد اليوم</h5>

                @if (!Model.TodayAppointments.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-cup-hot"></i>
                        <p class="mb-0">ما عندك مواعيد اليوم.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>المريض</th>
                                    <th>الوقت</th>
                                    <th>الحالة</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in Model.TodayAppointments)
                                {
                                    <tr>
                                        <td>@appt.PatientName</td>
                                        <td>@(appt.StartTime?.ToString(@"hh\:mm") ?? "-")</td>
                                        <td><span class="@StatusClass(appt.Status)">@StatusText(appt.Status)</span></td>
                                        <td>
                                            @if (appt.Status != ClinicPRO.Domain.Enums.AppointmentStatus.Completed)
                                            {
                                                <a asp-controller="Appointment" asp-action="WriteRecord"
                                                   asp-route-appointmentId="@appt.AppointmentId"
                                                   class="btn btn-sm btn-primary">كتابة السجل الطبي</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="mb-3"><i class="bi bi-calendar2-week"></i> المواعيد القادمة</h5>

                @if (!Model.UpcomingAppointments.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p class="mb-0">لا يوجد مواعيد قادمة.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>المريض</th>
                                    <th>التاريخ</th>
                                    <th>الوقت</th>
                                    <th>الحالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in Model.UpcomingAppointments)
                                {
                                    <tr>
                                        <td>@appt.PatientName</td>
                                        <td>@(appt.SlotDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                        <td>@(appt.StartTime?.ToString(@"hh\:mm") ?? "-")</td>
                                        <td><span class="@StatusClass(appt.Status)">@StatusText(appt.Status)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="mb-3"><i class="bi bi-lightning-charge"></i> إجراءات سريعة</h5>
                <div class="d-grid gap-2">
                    <a class="quick-tile" asp-controller="Appointment" asp-action="DoctorAppointments">
                        <span class="tile-icon"><i class="bi bi-journal-medical"></i></span> كل مواعيد المرضى
                    </a>
                    <a class="quick-tile" asp-controller="Appointment" asp-action="MySlots">
                        <span class="tile-icon"><i class="bi bi-clock-history"></i></span> إدارة الأوقات المتاحة
                    </a>
                    <a class="quick-tile" asp-controller="Notification" asp-action="Index">
                        <span class="tile-icon"><i class="bi bi-bell"></i></span> الإشعارات
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>